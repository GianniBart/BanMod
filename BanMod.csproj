<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<DebugType>none</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Il2CppInteropVerbose>true</Il2CppInteropVerbose>
		<Optimize>true</Optimize>

		<GenerateInteropAssemblies Condition="'$(DesignTimeBuild)' == 'true'">false</GenerateInteropAssemblies>

		<VersionPrefix>4.5.3</VersionPrefix>
		<Description>Ban automatico</Description>
		<Authors>Gianni</Authors>
		<AssemblyName>BanMod</AssemblyName>

		<GeneratedSecretFile>$(MSBuildProjectDirectory)\Generated\BanModBuildSecret.g.cs</GeneratedSecretFile>
		<BuildId>$([System.Guid]::NewGuid().ToString('N'))</BuildId>
	</PropertyGroup>

	<UsingTask
        TaskName="GenerateBanModBuildSecretTask"
        TaskFactory="RoslynCodeTaskFactory"
        AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

		<ParameterGroup>
			<BuildId ParameterType="System.String" Required="true" />
			<OutputFile ParameterType="System.String" Required="true" />
		</ParameterGroup>

		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />

			<Code Type="Fragment" Language="cs">
				<![CDATA[
                Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));

                string code =
@"// Auto-generated. Do not edit.
namespace BanMod
{
    internal static class BanModBuildSecret
    {
        public const string BuildId = """ + BuildId.Replace("\"", "\"\"") + @""";
    }
}
";

                File.WriteAllText(
                    OutputFile,
                    code,
                    new UTF8Encoding(false)
                );
            ]]>
			</Code>
		</Task>

	</UsingTask>

	<Target Name="GenerateBanModBuildSecret" BeforeTargets="BeforeCompile">

		<MakeDir Directories="$(MSBuildProjectDirectory)\Generated" />

		<GenerateBanModBuildSecretTask
            BuildId="$(BuildId)"
            OutputFile="$(GeneratedSecretFile)" />

		<WriteLinesToFile
            File="$(MSBuildProjectDirectory)\Generated\BanModBuildId.txt"
            Lines="$(BuildId)"
            Overwrite="true"
            Encoding="UTF-8" />

		<Message
            Importance="high"
            Text="BanMod $(VersionPrefix) BuildId=$(BuildId). No universal activation secret is embedded." />

	</Target>

	<ItemGroup>

		<EmbeddedResource
            Include="Resources/**/*"
            Exclude="Resources/**/*.cs;Resources/**/*.csproj" />

	</ItemGroup>

	<ItemGroup>

		<PackageReference
			Include="AmongUs.GameLibs.Steam"
			Version="2026.9.29" />

		<PackageReference
			Include="NextBepLoader.BepInEx.IL2CPP.MSBuild"
			Version="2.1.0-dev-6"
			PrivateAssets="all" />

		<PackageReference
			Include="BepInEx.Unity.IL2CPP"
			Version="6.0.0-be.785"
			ExcludeAssets="runtime;native" />

		<PackageReference
			Include="Samboy063.Cpp2IL.Core"
			Version="2022.1.0-pre-release.21"
			PrivateAssets="all" />

	</ItemGroup>
	<UsingTask
	TaskName="NextBepLoader.BepInEx.IL2CPP.MSBuild.GenerateInteropAssembliesTask"
	AssemblyFile="$(NuGetPackageRoot)nextbeploader.bepinex.il2cpp.msbuild\2.1.0-dev-6\tasks\netstandard2.1\NextBepLoader.BepInEx.IL2CPP.MSBuild.dll"
	Runtime="NET"
	Architecture="x64"
	TaskFactory="TaskHostFactory"
	Override="true"
	Condition="'$(MSBuildRuntimeType)' == 'Full'" />
	<Target Name="Copy" AfterTargets="Build">

		<Copy
            SourceFiles="$(TargetPath)"
            DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\Among Us\BepInEx\plugins"
            UseSymboliclinksIfPossible="true" />

		<Copy
            SourceFiles="$(TargetPath)"
            DestinationFolder="C:\Users\sepe2\Desktop\BanMod_MSStore-EpicGames-Steam-Xbox\BepInEx\plugins"
            UseSymboliclinksIfPossible="true" />

		<Copy
            SourceFiles="$(TargetPath)"
            DestinationFolder="C:\Users\sepe2\Desktop"
            UseSymboliclinksIfPossible="true" />

	</Target>

</Project>